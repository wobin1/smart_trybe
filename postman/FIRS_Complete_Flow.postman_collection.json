        {
          "name": "2.10 Submit FIRS workflow (client → IN_REVIEW)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Submitted for review', () => pm.response.to.have.status(200));",
                  "pm.test('Status IN_REVIEW', () => pm.expect(pm.response.json().status).to.eql('IN_REVIEW'));"
