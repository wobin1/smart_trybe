              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{client_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step_name\": \"Provide contact details\",\n  \"data\": {\n    \"contact_email\": \"compliance@firsflowtest.ng\",\n    \"contact_phone\": \"+2348012345678\"\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/workflow/FIRS/NEW/companies/{{company_id}}/steps/3/complete"
          }
        },
        {
          "name": "2.5 Complete step 4 — Nature of business",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Step 4 complete', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{client_token}}" },
