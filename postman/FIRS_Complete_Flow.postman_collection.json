            },
            "url": "{{base_url}}/api/v1/admin/companies/{{company_id}}/assign-agent"
          }
        },
        {
          "name": "3.3 Admin view company workflow progress",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Progress retrieved', () => pm.response.to.have.status(200));",
                  "const firs = pm.response.json().workflows.find(w => w.compliance_type === 'FIRS' && w.mode === 'NEW');",
                  "pm.test('FIRS in IN_REVIEW', () => pm.expect(firs.status).to.eql('IN_REVIEW'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/admin/companies/{{company_id}}/workflow-progress"
          }
        }
