            "body": {
              "mode": "raw",
              "raw": "{\n  \"step_name\": \"Provide CAC details\",\n  \"data\": {\n    \"cac_rc_number\": \"RC-FIRS-2026-001\"\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/workflow/FIRS/NEW/companies/{{company_id}}/steps/1/complete"
          }
        },
        {
          "name": "2.3 Complete step 2 — Business address",
          "event": [
            {
              "listen": "test",
