    {
      "name": "3 — Admin: Assign Agent",
      "item": [
        {
          "name": "3.1 Admin login (refresh token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('admin_token', pm.response.json().access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "3.2 Assign agent to company",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Agent assigned', () => pm.response.to.have.status(201));"],
                "type": "text/javascript"
              }
            }
