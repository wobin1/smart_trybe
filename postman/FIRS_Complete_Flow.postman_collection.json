    {
      "name": "4 — Agent: Complete FIRS",
      "item": [
        {
          "name": "4.1 Agent login (refresh token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Agent login OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('agent_token', pm.response.json().access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{agent_email}}\",\n  \"password\": \"{{agent_password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "4.2 List assigned companies",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Companies listed', () => pm.response.to.have.status(200));",
                  "const companies = pm.response.json().companies;",
                  "pm.test('Company assigned', () => {",
