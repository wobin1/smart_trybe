          }
        },
        {
          "name": "B.9 Status after fill — still unpaid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('still is_paid false', () => pm.expect(j.payment.is_paid).to.be.false);",
                  "const completed = j.steps.filter(s => s.is_completed);",
                  "pm.test('4 of 5 steps done (not payment)', () => pm.expect(completed.length).to.eql(4));"
