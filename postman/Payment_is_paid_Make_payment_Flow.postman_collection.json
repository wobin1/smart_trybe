        {
          "name": "B.7 Complete step 3 — payroll estimate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Step 3 done', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
