            },
            "url": "{{base_url}}/api/v1/workflow/ITF/NEW/companies/{{company_id}}/steps/3/complete"
          }
        },
        {
          "name": "B.8 Complete step 4 — submit application (confirm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Step 4 done', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{client_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step_name\": \"Submit application\",\n  \"data\": {\n    \"application_confirmed\": true\n  }\n}"
