                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{client_token}}" }
            ],
            "url": "{{base_url}}/api/v1/workflow/ITF/NEW/companies/{{company_id}}/status"
