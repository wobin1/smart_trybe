                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{client_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step_name\": \"Upload staff list\",\n  \"data\": {\n    \"staff_list_notes\": \"Staff list prepared for ITF filing\"\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/workflow/ITF/NEW/companies/{{company_id}}/steps/2/complete"
          }
