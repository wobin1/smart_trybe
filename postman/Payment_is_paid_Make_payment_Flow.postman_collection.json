                  "pm.test('COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{client_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_id\": \"{{payment_id}}\",\n  \"payment_reference\": \"{{payment_reference}}\",\n  \"start_workflows\": true\n}"
            },
            "url": "{{base_url}}/api/v1/cart/companies/{{company_id}}/pay"
          }
        },
        {
          "name": "B.13 Status after pay — is_paid + Make payment completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('is_paid true', () => pm.expect(j.payment.is_paid).to.be.true);",
                  "pm.test('payment_reference set', () => pm.expect(j.payment.payment_reference).to.be.ok);",
                  "const payStep = j.steps.find(s => s.step_name === 'Make payment');",
                  "pm.test('Make payment auto-completed', () => pm.expect(payStep.is_completed).to.be.true);",
                  "pm.test('step_data has payment_reference', () => {",
                  "  pm.expect(payStep.step_data.payment_reference).to.be.ok;",
                  "});",
                  "const completed = j.steps.filter(s => s.is_completed);",
                  "pm.test('all 5 steps completed', () => pm.expect(completed.length).to.eql(5));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
