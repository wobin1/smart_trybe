DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_trybe_compliance
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAILS=admin@example.com
PUBLIC_API_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Paystack — set PAYMENT_DEV_MODE=false in production when Paystack is configured
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYMENT_DEV_MODE=true
PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/callback

# Zoho Flow webhooks — create one Flow per event; paste each webhook URL here
ZOHO_FLOW_WEBHOOK_PAYMENT=https://flow.zoho.com/xxxx/webhook/incoming?zapikey=...
ZOHO_FLOW_WEBHOOK_WORKFLOW_SUBMITTED=https://flow.zoho.com/xxxx/webhook/incoming?zapikey=...
ZOHO_FLOW_WEBHOOK_AGENT_ASSIGNED=https://flow.zoho.com/xxxx/webhook/incoming?zapikey=...
ZOHO_FLOW_WEBHOOK_WORKFLOW_COMPLETED=https://flow.zoho.com/xxxx/webhook/incoming?zapikey=...
ZOHO_FLOW_WEBHOOK_SECRET=optional-shared-secret-for-x-webhook-signature
